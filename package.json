{
  "name": "@carbon-ni/pi-schedule",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carbon-ni/pi-schedule.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pi-package",
    "pi",
    "scheduler"
  ],
  "type": "module",
  "description": "Session-scoped scheduled follow-ups for Pi",
  "packageManager": "npm@10.9.9",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "DEVELOPMENT.md",
    "docs"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.5.0 <2",
    "typebox": "1.3.15"
  },
  "overrides": {
    "minimatch": "11.0.4"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:coverage": "node scripts/test.mjs --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "sh scripts/gate.sh"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typebox": "1.3.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
